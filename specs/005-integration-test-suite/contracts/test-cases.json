      },
      "expected_result_type": "SearchResult[User]",
      "validator_type": "user",
      "enabled": true,
      "notes": "Partial email match"
    },
    {
      "id": "user-search-name-exact-1",
      "method": "UserService.SearchByNameExact",
      "service": "User",
      "operation": "SearchByNameExact",
