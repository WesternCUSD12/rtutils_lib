{
  "version": "1.0",
  "description": "Integration test case definitions for rtutils library",
  "created": "2026-02-05",
  "test_cases": [
    {
      "id": "ticket-get-1",
      "method": "TicketService.Get",
      "service": "Ticket",
      "operation": "Get",
      "description": "Fetch a single ticket by ID",
      "inputs": {
        "id": "1"
      },
      "expected_result_type": "Ticket",
      "validator_type": "ticket",
      "enabled": true,
      "notes": "Assumes ticket #1 exists in RT instance"
    },
    {
      "id": "ticket-getbyurl-1",
      "method": "TicketService.GetByURL",
      "service": "Ticket",
      "operation": "GetByURL",
      "description": "Fetch ticket by full RT URL",
      "inputs": {
        "url": "/REST/2.0/ticket/1"
      },
      "expected_result_type": "Ticket",
      "validator_type": "ticket",
      "enabled": true,
      "notes": "Tests URL-based retrieval mechanism"
    },
    {
      "id": "ticket-search-1",
      "method": "TicketService.Search",
      "service": "Ticket",
      "operation": "Search",
      "description": "Search tickets with TicketSQL query",
      "inputs": {
        "query": "Status = 'new' OR Status = 'open'",
        "page": 1,
        "per_page": 20
      },
      "expected_result_type": "SearchResult[Ticket]",
      "validator_type": "ticket",
      "enabled": true,
      "notes": "Searches for open tickets. Expands summary results to full details"
    },
    {
      "id": "ticket-search-subject-1",
      "method": "TicketService.SearchBySubject",
      "service": "Ticket",
      "operation": "SearchBySubject",
      "description": "Search tickets by subject substring",
      "inputs": {
        "query": "test"
      },
      "expected_result_type": "SearchResult[Ticket]",
      "validator_type": "ticket",
      "enabled": true,
      "notes": "Fuzzy match on subject field, no exact match required"
    },
    {
      "id": "user-get-1",
      "method": "UserService.Get",
      "service": "User",
      "operation": "Get",
      "description": "Fetch a single user by ID or username",
      "inputs": {
        "id": "admin"
      },
      "expected_result_type": "User",
      "validator_type": "user",
      "enabled": true,
      "notes": "Assumes 'admin' user exists"
    },
    {
      "id": "user-search-1",
      "method": "UserService.Search",
      "service": "User",
      "operation": "Search",
      "description": "Search users by query",
      "inputs": {
        "query": "Name LIKE '%'"
      },
      "expected_result_type": "SearchResult[User]",
      "validator_type": "user",
      "enabled": true,
      "notes": "Returns all users (LIKE '%' matches all names)"
    },
    {
      "id": "user-search-username-exact-1",
      "method": "UserService.SearchByUsernameExact",
      "service": "User",
      "operation": "SearchByUsernameExact",
