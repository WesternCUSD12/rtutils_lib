      "inputs": {
        "username": "admin"
      },
      "expected_result_type": "SearchResult[User]",
      "validator_type": "user",
      "enabled": true,
      "notes": "Exact match required"
    },
    {
      "id": "user-search-username-partial-1",
      "method": "UserService.SearchByUsernamePartial",
      "service": "User",
      "operation": "SearchByUsernamePartial",
      "description": "Find users by partial username",
      "inputs": {
        "query": "adm"
      },
      "expected_result_type": "SearchResult[User]",
      "validator_type": "user",
      "enabled": true,
      "notes": "Partial match using LIKE operator"
    },
    {
